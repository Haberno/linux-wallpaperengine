VERSION = "1.0"
DEFAULT_INTERVAL = 0.5
MIB = 1024 * 1024
GIB = 1024 * MIB
# "HH:MM:SS.mmm [LEVEL] message" as written by WallpaperEngine::Logging::Log
LOG_LINE = re.compile(r"^(\d{2}:\d{2}:\d{2}\.\d{3}) \[([A-Z]+)\] (.*)$")


