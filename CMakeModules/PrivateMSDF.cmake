include(FetchContent)
FetchContent_Declare(lwe_msdfgen
    URL https://codeload.github.com/Chlumsky/msdfgen/tar.gz/refs/tags/v1.13
    URL_HASH SHA256=93cd1ad8918c1a78c5c96e82d4f4c77f0eb86c2e7e8579a0967e54196c4b7167)
FetchContent_GetProperties(lwe_msdfgen)
if(NOT lwe_msdfgen_POPULATED)
    FetchContent_Populate(lwe_msdfgen)
endif()

function(lwe_add_private_msdf)
    set(BUILD_SHARED_LIBS OFF)
    set(CMAKE_POSITION_INDEPENDENT_CODE ON)
    set(MSDFGEN_CORE_ONLY OFF CACHE BOOL "" FORCE)
    set(MSDFGEN_BUILD_STANDALONE OFF CACHE BOOL "" FORCE)
    set(MSDFGEN_USE_VCPKG OFF CACHE BOOL "" FORCE)
    set(MSDFGEN_USE_SKIA OFF CACHE BOOL "" FORCE)
    set(MSDFGEN_DISABLE_SVG ON CACHE BOOL "" FORCE)
    set(MSDFGEN_DISABLE_PNG ON CACHE BOOL "" FORCE)
    set(MSDFGEN_USE_OPENMP OFF CACHE BOOL "" FORCE)
    set(MSDFGEN_INSTALL OFF CACHE BOOL "" FORCE)
    add_subdirectory("${lwe_msdfgen_SOURCE_DIR}" "${lwe_msdfgen_BINARY_DIR}" EXCLUDE_FROM_ALL)
endfunction()
lwe_add_private_msdf()
install(FILES "${lwe_msdfgen_SOURCE_DIR}/LICENSE.txt" DESTINATION licenses/msdfgen)
